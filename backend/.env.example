# Copie este arquivo para .env e preencha com valores reais.
# NUNCA faça commit do arquivo .env — apenas deste .env.example.
PORT=3000

DATABASE_URL=postgresql://usuario:senha@host:5432/postgres
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque-aqui-a-service-role-key
SUPABASE_BUCKET=arquivos-sra

# Gere um valor aleatório forte, ex.: openssl rand -hex 32
JWT_SECRET=

FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=uploads
